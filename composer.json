{
    "name": "kopexa/mautic-oauth-bundle",
    "description": "OAuth 2.1 authorization server for Mautic (authorization code + PKCE S256, refresh tokens, dynamic client registration, RFC 8414 metadata, JWKS). Used by MCP clients such as Claude and ChatGPT.",
    "type": "mautic-plugin",
    "license": "Apache-2.0",
    "keywords": [
        "mautic",
        "plugin",
        "oauth2",
        "oauth2.1",
        "pkce",
        "mcp"
    ],
    "homepage": "https://github.com/kopexa-grc/mautic-oauth-bundle",
    "support": {
        "issues": "https://github.com/kopexa-grc/mautic-oauth-bundle/issues",
        "source": "https://github.com/kopexa-grc/mautic-oauth-bundle",
        "security": "https://github.com/kopexa-grc/mautic-oauth-bundle/security/policy"
    },
    "authors": [
        {
            "name": "Kopexa",
            "homepage": "https://kopexa.com"
        }
    ],
    "extra": {
        "install-directory-name": "KopexaOAuthBundle"
    },
    "require": {
        "php": "~8.4",
        "ext-openssl": "*",
        "mautic/core-lib": "^7.2",
        "league/oauth2-server": "^9.4",
        "guzzlehttp/psr7": "^2.7",
        "defuse/php-encryption": "^2.4"
    },
    "minimum-stability": "stable"
}
